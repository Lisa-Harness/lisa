# Lisa Framework — provider credentials (LISA_* env vars)
# The new hosts/cli, hosts/web read these names.
# The provider code also accepts bare AZURE_OPENAI_* / OPENAI_API_KEY /
# ANTHROPIC_API_KEY / GOOGLE_API_KEY / OLLAMA_HOST as fallbacks.

# Local development override: keep the CLI host pointed at ./artifacts
# so the in-repo state/threads/models are used during local runs.
# This helps with debugging.
LISA_DATA_DIR=./artifacts

# Path to the session context file. Overrides auto-discovery of session_context.md.
LISA_SESSION_CONTEXT_PATH=./path/to/session_context.md

# Storage sandbox denylist (lisa-storage MCP server). Comma-separated,
# forward-slash fnmatch globs matched against relative paths under
# data_dir/files. Defense-in-depth: these patterns cover sensitive
# artifacts the storage server could otherwise list/read. The host
# process env is inherited by the lisa-storage subprocess
# (EnvPolicy.inherit_parent=True by default), so this var is effective
# without editing hosts/core/mcp_servers.yaml. See
# mcp_server/storage/server.py:main and sdk/storage/_backend.py for the
# matching logic.
LISA_STORAGE_DENY_GLOBS=*.db,threads/**,repl_history.txt

# ── Turn-runner tuning knobs ──────────────────────────────────────────
# These env vars map to kernel-owned Settings in kernel/config.py and
# are read by the turn runner (kernel/turn_runner.py). Values below are
# deliberately loosened for long-running local work; the code defaults
# are shown per entry. Set a value to 0 to lift a cap where supported.

# Maximum model-completion iterations per turn. Shared across all mode
# handoffs within a turn (the counter is not reset on transition).
# Code default: 15.
MAX_TOOL_ITERATIONS=300

# Per-child iteration cap for fork fan-out. Fork children run in parallel
# and get a smaller slice than a full sequential turn.
# Code default: 5.
FORK_CHILD_MAX_TOOL_ITERATIONS=50

# Per-step iteration sub-budget. Each workflow step (between two
# transition_stage handoffs) gets its own budget so a chained
# producer→consumer pipeline does not starve its final step on the
# shared MAX_TOOL_ITERATIONS budget. Code default: 8.
PER_STEP_MAX_ITERATIONS=75

# Per-step tool-call sub-budget. Secondary guard against a model that
# burns many tool calls within one step without converging.
# Code default: 12.
PER_STEP_MAX_TOOL_CALLS=150

# Hard backstop against routing-hint loops: caps the total mode handoffs
# per turn and forces a final completion. Code default: 6.
MAX_HANDOFFS_PER_TURN=50

# Consecutive routing-hint overrides (model hands off to a target that
# differs from the hint's suggested target) before the hint layer stops
# injecting further hints for the rest of the turn. Code default: 2.
HINT_OVERRIDE_LIMIT=50

# Forced-fork enforcer: when a fork: routing hint is active and the model
# refuses to call transition_stage (burning iterations on read-only tools
# or empty completions), the kernel forces the fork after this many
# non-fork tool dispatches. Code default: 2.
FORCED_FORK_NON_FORK_TOOL_CAP=2

# Forced-plan enforcer: same pattern as above for plan-escalation routing
# hints — bounds the pre-plan token burn. Code default: 2.
FORCED_PLAN_NON_TRANSITION_TOOL_CAP=2

# Stuck-session guard: after this many turns in the same stage without a
# transition, the loop injects a nudge. Code default: 4.
STAGE_NUDGE_THRESHOLD=4

# After this many turns in the same stage, the loop forces a final
# no-tools completion to stop burning tokens. Code default: 6.
STAGE_NUDGE_CAP=6

# Consecutive identical routing hints before duplicate-hint dedup
# suppresses injection. Code default: 2.
DUPLICATE_HINT_LIMIT=2

# Minimum hint-target history length that forms a detectable 2-cycle
# (A, B, A). Code default: 3.
HINT_CYCLE_MIN_LEN=3

# Inject a compact, per-iteration budget status block into the system
# prompt so the model can self-scope its work. Set to false to disable.
# Code default: true.
BUDGET_BRIEFING_ENABLED=true

# Memory-pack learning distillation budget. NOTE: the kernel does not
# read this env name. The lisa-pack-memory op reads
# ``memory_distill_max_tokens`` from the session-manifest pack config
# (resources.packs.configuration.lisa-pack-memory), which is what this
# entry corresponds to for reference. See sdk/packs/memory/operations/memory/synthesize_learning.py.
# Code fallback: 512.
DISTILL_MAX_TOKENS=10000

# Ollama is available by default but if you want to use a custom URL:
#LISA_OLLAMA_HOST=

# Other providers require API keys and sometimes URLs:

LISA_ANTHROPIC_API_KEY=
LISA_ANTHROPIC_BASE_URL=https://api.anthropic.com
LISA_ANTHROPIC_VERSION=2023-06-01

LISA_AZURE_OPENAI_API_VERSION=2024-10-21
LISA_AZURE_OPENAI_API_KEY=
LISA_AZURE_OPENAI_ENDPOINT=https://your-project.services.ai.azure.com/

LISA_GOOGLE_API_KEY=
LISA_GOOGLE_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta3/models

LETTA_API_KEY=
LETTA_BASE_URL=https://api.letta.com
LETTA_AGENT_ID=

# lisa-pack-mem0 requires an API key
MEM0_API_KEY=

# lisa-pack-brave-search requires a Brave Search API key and endpoint
WEB_SEARCH_API_KEY=
WEB_SEARCH_ENDPOINT=https://api.search.brave.com/res/v1/web/search

# Other packs may require additional environment variables. Add them below:
