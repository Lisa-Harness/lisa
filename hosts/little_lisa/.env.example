# Simple host environment configuration
# Copy this file to .env in the same folder and fill values as needed.

# Optional path override for the model manifest.
# Default: examples/simple_host/models.yaml
LITTLE_LISA_MODELS_FILE=

# Azure OpenAI (used when provider=azure_openai in models.yaml)
LITTLE_LISA_AZURE_OPENAI_ENDPOINT=
LITTLE_LISA_AZURE_OPENAI_API_KEY=
LITTLE_LISA_AZURE_OPENAI_API_VERSION=2024-10-21

# OpenAI direct (used when provider=openai in models.yaml)
LITTLE_LISA_OPENAI_API_KEY=

# Anthropic Claude direct (used when provider=anthropic in models.yaml)
LITTLE_LISA_ANTHROPIC_API_KEY=
LITTLE_LISA_ANTHROPIC_BASE_URL=https://api.anthropic.com
LITTLE_LISA_ANTHROPIC_VERSION=2023-06-01

LITTLE_LISA_GOOGLE_API_KEY=
LITTLE_LISA_GOOGLE_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Local Ollama via OpenAI-compatible API (used when provider=ollama in models.yaml)
LITTLE_LISA_OLLAMA_HOST=127.0.0.1:11434
LITTLE_LISA_OLLAMA_API_KEY=

# Optional fallback env vars (used if LITTLE_LISA_* values above are empty)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OLLAMA_HOST=
OLLAMA_API_KEY=

# Optional Mem0 cloud memory backend (used when memory.default_backend=mem0
# in mcp_servers.yaml). Get a key at https://app.mem0.ai → API Keys.
MEM0_API_KEY=

# Optional web search support used by /search operation.
WEB_SEARCH_API_KEY=

# Optional runtime logging threshold: debug, info, warning, error.
# When empty, --debug implies debug logging, otherwise defaults to info.
LITTLE_LISA_LOG_LEVEL=

# Optional pack authoring root(s), separated by os.pathsep (; on Windows).
# Example (Windows): C:\Code\lisa-pack-hello-world
SDK_CONTENT_ROOTS=
